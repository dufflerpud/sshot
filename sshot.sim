COMMENT doc#	Trivial program SShot written in Simula
COMMENT #######################################################################
COMMENT ////////////////////////////////////////////////////////////////;
COMMENT SShot implemented in Simula by Chris Caldwell 11/03/2022	;
COMMENT Tested on cim-5.1.tar.gz					;
COMMENT ////////////////////////////////////////////////////////////////;

BEGIN

COMMENT ////////////////////////////////////////////////////////////////;
COMMENT Space over distance spaces and OUTTEXT given string.		;
COMMENT ////////////////////////////////////////////////////////////////;
    PROCEDURE redraw_positions ( distance, object_text );
	INTEGER distance;
	TEXT object_text;
	BEGIN
	OUTTEXT ("]");
	WHILE distance > 0 DO
	    BEGIN
	    distance := distance - 1;
	    OUTTEXT (" ")
	    END;
	OUTTEXT ( object_text );
	OUTIMAGE
	END;

COMMENT ////////////////////////////////////////////////////////////////;
COMMENT Main								;
COMMENT ////////////////////////////////////////////////////////////////;

    INTEGER spaceship_distance;
    INTEGER shot_distance;
    INTEGER seed;

    seed := 0;
    spaceship_distance := UNIFORM(10,75,seed);

    WHILE spaceship_distance > 0 DO
	BEGIN
	redraw_positions( spaceship_distance, "*" );
	OUTTEXT ("Enter new shot distance: ");
	BREAKOUTIMAGE;
	shot_distance := ININT;
	IF shot_distance < 1 OR shot_distance > 75 THEN
	    BEGIN
	    OUTTEXT ("You must enter an integer between 1 and 75." );
	    OUTIMAGE
	    END
	ELSE IF shot_distance = spaceship_distance THEN
	    BEGIN
	    redraw_positions( spaceship_distance, "<<Kaboom>>" );
	    OUTTEXT ("Spaceship destroyed. You win.");
	    OUTIMAGE;
	    spaceship_distance := -1
	    END
	ELSE
	    BEGIN
	    redraw_positions( shot_distance, "." );
	    spaceship_distance := spaceship_distance - UNIFORM(5,15,seed);
	    IF spaceship_distance <= 0 THEN
		BEGIN
		redraw_positions( 1, "<<Kaboom>>" );
		OUTTEXT ("Spaceship has collided with you. You lose.");
		OUTIMAGE;
		spaceship_distance := -1
		END
	    END
	END
    END
